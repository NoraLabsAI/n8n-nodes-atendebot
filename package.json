{
	"name": "n8n-nodes-atendebot",
	"version": "0.1.0",
	"description": "n8n community node for AtendeBot: contacts, deals, messages and tasks.",
	"license": "MIT",
	"homepage": "https://github.com/noralabs/n8n-nodes-atendebot",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "NoraLabs",
		"email": "dev@noralabs.co"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/noralabs/n8n-nodes-atendebot.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AtendeBotApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AtendeBot/AtendeBot.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^24.0.0",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
